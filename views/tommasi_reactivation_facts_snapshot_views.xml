<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tommasi_reactivation_facts_snapshot_view_tree" model="ir.ui.view">
        <field name="name">tommasi.reactivation.facts.snapshot.tree</field>
        <field name="model">tommasi.reactivation.facts.snapshot</field>
        <field name="arch" type="xml">
            <tree string="Facts snapshots" create="false" edit="false" delete="false">
                <field name="partner_id" />
                <field name="seller_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="last_purchase_date" />
                <field name="days_inactive" />
                <field name="revenue_recent" />
                <field name="revenue_change_pct" />
                <field name="qty_change_pct" />
                <field name="computed_at" />
                <field name="date_from" optional="hide" />
                <field name="date_to" optional="hide" />
                <field name="config_hash" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="tommasi_reactivation_facts_snapshot_view_form" model="ir.ui.view">
        <field name="name">tommasi.reactivation.facts.snapshot.form</field>
        <field name="model">tommasi.reactivation.facts.snapshot</field>
        <field name="arch" type="xml">
            <form string="Facts snapshot" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Partner">
                            <field name="partner_id" readonly="1" />
                            <field name="seller_id" readonly="1" />
                            <field
                                name="company_id"
                                readonly="1"
                                groups="base.group_multi_company"
                            />
                            <field name="last_purchase_date" readonly="1" />
                            <field name="days_inactive" readonly="1" />
                        </group>
                        <group string="Freshness">
                            <field name="computed_at" readonly="1" />
                            <field name="date_from" readonly="1" />
                            <field name="date_to" readonly="1" />
                            <field name="config_hash" readonly="1" />
                        </group>
                    </group>
                    <group string="Detection window metrics">
                        <group>
                            <field name="revenue_prior" readonly="1" />
                            <field name="revenue_recent" readonly="1" />
                            <field name="revenue_change_pct" readonly="1" />
                        </group>
                        <group>
                            <field name="qty_change_pct" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales history" name="sales_history">
                            <field
                                name="sales_history_json"
                                readonly="1"
                                nolabel="1"
                                widget="text"
                            />
                        </page>
                        <page string="Product history" name="product_history">
                            <field
                                name="product_history_json"
                                readonly="1"
                                nolabel="1"
                                widget="text"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tommasi_reactivation_facts_snapshot_view_search" model="ir.ui.view">
        <field name="name">tommasi.reactivation.facts.snapshot.search</field>
        <field name="model">tommasi.reactivation.facts.snapshot</field>
        <field name="arch" type="xml">
            <search string="Facts snapshots">
                <field name="partner_id" />
                <field name="seller_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    string="Fresh (&lt; 24h)"
                    name="fresh"
                    domain="[('computed_at', '&gt;=', (datetime.datetime.now() - datetime.timedelta(hours=24)).strftime('%Y-%m-%d %H:%M:%S'))]"
                />
                <filter
                    string="Revenue decline"
                    name="revenue_decline"
                    domain="[('revenue_change_pct', '&lt;', 0)]"
                />
                <group expand="0" string="Group by">
                    <filter
                        string="Salesperson"
                        name="group_seller"
                        context="{'group_by': 'seller_id'}"
                    />
                    <filter
                        string="Company"
                        name="group_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                    <filter
                        string="Last purchase"
                        name="group_last_purchase"
                        context="{'group_by': 'last_purchase_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_tommasi_reactivation_facts_snapshot" model="ir.actions.act_window">
        <field name="name">Facts snapshots</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tommasi.reactivation.facts.snapshot</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="tommasi_reactivation_facts_snapshot_view_search" />
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No facts snapshots yet.
            </p>
            <p>
                Nightly cron materializes invoice aggregates for bootstrap-qualified
                customers. Use <strong>Action → Refresh facts snapshots</strong> to
                run the refresh manually.
            </p>
        </field>
    </record>

    <record
        id="action_refresh_facts_snapshots_server"
        model="ir.actions.server"
    >
        <field name="name">Refresh facts snapshots</field>
        <field name="model_id" ref="model_tommasi_reactivation_facts_snapshot" />
        <field
            name="binding_model_id"
            ref="model_tommasi_reactivation_facts_snapshot"
        />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_facts_snapshots()</field>
    </record>
</odoo>
